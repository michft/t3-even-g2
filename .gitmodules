# Metadata for nested gitlinks imported with the read-only reference snapshot.
# Reference repositories are synchronized by scripts/lib/reference-repos.ts.
[submodule ".repos/alchemy-effect/submodules/distilled"]
	path = .repos/alchemy-effect/submodules/distilled
	url = https://github.com/alchemy-run/distilled.git
	update = none
[submodule ".repos/alchemy-effect/submodules/floci"]
	path = .repos/alchemy-effect/submodules/floci
	url = https://github.com/alchemy-run/floci.git
	shallow = true
	update = none
	ignore = all
